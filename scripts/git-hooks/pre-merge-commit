#!/usr/bin/env bash
set -euo pipefail

# Nazgul pre-merge-commit guard — parallel-unit verdict check. Blocks
# `git merge --no-ff` of a task unit whose manifest under nazgul/tasks/
# records a merged commit but is not yet Status: DONE.
#
# Identity is resolved from GITHEAD_<sha> environment variables, not
# GIT_REFLOG_ACTION: git's setenv(..., overwrite=0) only sets REFLOG_ACTION
# when absent, so a caller can pre-set it to claim an approved unit while
# merging different, unreviewed content. GITHEAD_<sha> keys are different:
# git names the variable itself after the actual merged commit's SHA (one
# per head being merged), so the key can't be relabeled — only extra decoy
# keys can be added alongside it. Each GITHEAD_<sha> entry's VALUE is also
# the ref git is merging, e.g. `feat/FEAT-009/TASK-165` — a second identity
# signal bound to that SAME key. For every key we derive two candidates:
# (1) content-match, via <sha> against a manifest's ## Commits section
# (Fix 1a), and (2) ref-derived, via a `TASK-NNN` named by that same key's
# ref, anchored to the canonical `^feat/[^/]+/TASK-[0-9]+$` shape produced by
# scripts/worktree-utils.sh:125 (create_task_worktree) and
# merge_task_to_feature — not a bare substring parse, which would also match
# non-canonical branches like `docs/TASK-001` and false-block them (see
# tests/test-git-hooks-premerge.sh's FALSE-BLOCK REGRESSION case). An
# off-convention branch name simply evades the ref signal and falls back to
# content-matching only — no regression versus pre-1b behaviour. BOTH
# signals are checked for EVERY key (not just the first match), so a decoy
# key's ref value resolves harmlessly (same as its decoy content-match
# always has), while the genuine key — the one git itself set for the
# actual merged content — is still independently checked by both its own
# content-match AND its own ref-derived signal. Laundering real content
# therefore still requires forging the genuine key's own manifest, not
# merely adding an unrelated decoy elsewhere in the environment.
#
# BLOCK if any resolved candidate names a task whose Status is not DONE, or
# (Fix 1c) names a task — via the ref-derived signal — whose ## Commits
# section records no commit matching that key's SHA: a DONE unit identified
# only by branch name that cannot be verified against the merged content is
# "matched but unverifiable", not "no candidate found", so it BLOCKS rather
# than silently falling through to allow. (MERGE_HEAD is not usable here:
# git only writes it for a stopped/conflicted or --no-commit merge, not for
# the clean auto-committed merges this guard runs on — confirmed
# empirically, git 2.48, ort strategy.)
#
# KNOWN, PERMANENT LIMIT — the compound miss. If a merge's ref is
# off-convention (does not match ^feat/[^/]+/TASK-[0-9]+$) AND no manifest's
# ## Commits section records the merged SHA, BOTH identity signals miss and
# the merge is ALLOWED. This is not closable at this site, and is documented
# here as a limit of the identity model rather than as a deferred fix:
#   * A "does this merge touch nazgul/tasks/?" signal is structurally
#     vacuous — nazgul/ is gitignored (.gitignore:2,15) and per-worktree, so
#     manifest edits are never part of ANY commit tree; `git log -- nazgul/
#     tasks/` is empty by construction. git cannot see the state the guard
#     would need.
#   * Failing closed instead would block ordinary human merges whose only
#     "offense" is a TASK-NNN-shaped branch name — pinned against by the
#     FALSE-BLOCK REGRESSION case (tests/test-git-hooks-premerge.sh:378-393),
#     which exists because a previously-shipped guard over-blocked. This hook
#     installs repo-wide via core.hooksPath and fires on EVERY
#     `git merge --no-ff`, including merges unrelated to Nazgul.
#   * With neither signal the guard's honest state is "no evidence this is a
#     task merge at all" — absence of evidence, not weak evidence.
# Closing it properly needs an independent, mechanically-populated SHA<->task
# record (e.g. a post-commit hook writing a worktree-local marker) — a real
# feature, still --no-verify-bypassable, out of scope here. The path is not
# silent: it emits a stderr advisory before allowing (see below).
#
# git pre-merge-commit contract: no argv, no stdin read, exit 0 = allow,
# nonzero = block (message on stderr).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
[ -n "$REPO_ROOT" ] || exit 0

CONFIG="$REPO_ROOT/nazgul/config.json"
DISPATCH="$(cd "$(dirname "$0")" && pwd)/_dispatch.sh"

_dispatch_and_exit() {
  if [ -f "$DISPATCH" ]; then
    export CLAUDE_PROJECT_DIR="$REPO_ROOT"
    # shellcheck source=/dev/null
    source "$DISPATCH"
    dispatch_prior_hook pre-merge-commit
    exit $?
  fi
  exit 0
}

# Every check below reads config/manifests via jq/grep. No jq -> nothing
# downstream is safely readable -> degrade to allow immediately, before any
# config read.
command -v jq >/dev/null 2>&1 || _dispatch_and_exit

[ -f "$CONFIG" ] || _dispatch_and_exit

# `// true` would treat a literal `false` as falsy too (jq quirk), so compare
# explicitly — only an explicit `false` disables the guard.
GIT_HOOKS_ENABLED=$(jq -r 'if .guards.git_hooks == false then "false" else "true" end' "$CONFIG" 2>/dev/null || echo "true")
[ "$GIT_HOOKS_ENABLED" = "true" ] || _dispatch_and_exit

# MF-053 / ADR-003 Decision 3: config present-but-corrupt fails CLOSED.
# The kill-switch read above already defaults to "true" (enabled) on a parse
# failure — the safe direction — but PARALLEL below defaults to "false",
# which for THIS guard means "skip the entire merge-verdict check". ADR-009
# names this guard's false-allow catastrophic (unreviewed code permanently
# enters the trunk of record), so an unparseable config must not silently
# disarm it. A genuinely ABSENT config still no-ops at the `[ -f ]` test
# above; only present-but-corrupt blocks. Placed after the kill-switch reads
# (a VALID `guards.git_hooks: false` still disables the guard exactly as
# before) and immediately before the one read whose default is unsafe —
# mirroring scripts/parallel-dispatch-guard.sh:26 and
# scripts/parallel-rework-guard.sh:25, which already ship this check.
# exit 1, not 2: this is a git hook (0 allow / nonzero block), not a
# PreToolUse hook. Block paths in this file exit directly and do not
# chain-dispatch; forwarding applies on the allow path only.
jq -e . "$CONFIG" >/dev/null 2>&1 || {
  echo "NAZGUL GUARD: Blocked — nazgul/config.json is present but unparseable; cannot verify parallel-dispatch merge safety. Fix or remove the file." >&2
  exit 1
}

PARALLEL=$(jq -r '.execution.parallel // false' "$CONFIG" 2>/dev/null || echo "false")
[ "$PARALLEL" = "true" ] || _dispatch_and_exit

ENFORCE=$(jq -r 'if .execution.enforce.premerge_guard == false then "false" else "true" end' "$CONFIG" 2>/dev/null || echo "true")
[ "$ENFORCE" = "true" ] || _dispatch_and_exit

# Status is read frontmatter-first, mirroring scripts/lib/task-utils.sh's
# get_task_status/read_task_status (canonical `status:` inside the leading
# --- fence wins over the legacy `- **Status**:` list-item line, which can go
# stale). This hook can't source that lib — it runs standalone in target
# repos — so the same precedence is replicated here, shared by both signals.
task_status() {
  local tf="$1" st
  st=$(awk '/^---[[:space:]]*$/{fm++; next} fm==1 && /^status:/{sub(/^status:[[:space:]]*/, ""); sub(/[[:space:]\r]+$/, ""); print; exit}' "$tf" 2>/dev/null)
  if [ -z "$st" ]; then
    st=$(grep -E '^\- \*\*Status\*\*:' "$tf" 2>/dev/null | head -1 | sed 's/^.*: *//' | tr -d ' \r')
  fi
  printf '%s' "$st"
}

# True if $tf's ## Commits section (bounded to the next ## heading, not a
# fixed line count — multi-retry manifests can carry commit lists well past
# 10 lines) records $sha as a DELIVERED commit: the leading hex token of a
# `- ` bullet's opening line, optionally backticked. Prefix-tolerant, so
# short-SHA authoring still matches git's always-full GITHEAD_<sha> (Fix 1a).
#
# ANCHORED deliberately (PR #74 review). The prior whole-section token scan
# also matched hex mentioned anywhere in narrative prose, and the two call
# sites have OPPOSITE polarity:
#   * Signal 1 (:126-136) blocks when a token matches a non-DONE manifest —
#     a spurious match there is a false BLOCK: safe direction.
#   * Signal 2 (:153-158) blocks when this function FAILS — so a spurious
#     match there SUPPRESSES the unverifiable-block and ADMITS the merge:
#     fail-OPEN, on the one gate standing between "manifest is DONE but the
#     merged content is not what it claims" and trunk.
# Anchoring is therefore a net tightening. Verified against all 22 live +
# archived manifests: 20 unchanged; the only tokens dropped are narrative
# cross-references (a Base SHA, a short duplicate of an anchored commit, a
# superseded pre-rebase SHA, two non-commit hex strings). No manifest records
# a delivered commit only in prose, and the authoring contract mandates the
# bullet form (FEAT-023/TASK-008: templates/task-manifest.md,
# agents/implementer.md).
commits_verify() {
  local tf="$1" sha="$2" tok
  for tok in $(awk '/^## Commits/{f=1;next} /^## /{f=0} f' "$tf" 2>/dev/null \
      | grep -oE '^-[[:space:]]*`?[0-9a-f]{7,64}' \
      | grep -oE '[0-9a-f]{7,64}' || true); do
    case "$sha" in "$tok"*) return 0 ;; esac
  done
  return 1
}

# Candidate (sha, ref) pairs — one GITHEAD_<sha>=<ref> per head git is
# merging. Any failure in this pipeline (jq choking on a hostile/unexpected
# env) -> treat as no candidates, same as "no merge in progress" -> degrade
# to allow.
CANDIDATE_PAIRS_JSON=$(env | sed -nE 's/^GITHEAD_([0-9a-f]{40,64})=(.*)$/\1\t\2/p' | jq -R -s '
    split("\n") | map(select(length > 0) | split("\t") | {sha: .[0], ref: (.[1] // "")})
  ' 2>/dev/null) || CANDIDATE_PAIRS_JSON='[]'
[ "$(printf '%s' "$CANDIDATE_PAIRS_JSON" | jq 'length' 2>/dev/null || echo 0)" -gt 0 ] || _dispatch_and_exit

REF_TASK_RE='^feat/[^/]+/(TASK-[0-9]+)$'
UNIT_ID=""
STATUS=""
KIND=""
while IFS=$'\t' read -r CANDIDATE_SHA CANDIDATE_REF; do
  [ -n "$CANDIDATE_SHA" ] || continue

  # Signal 1 (Fix 1a): content-match, checked across EVERY manifest (not
  # just the first) so a decoy key for a DONE unit can't mask a genuine,
  # unapproved candidate also present in the same merge.
  for tf in "$REPO_ROOT/nazgul/tasks"/TASK-*.md; do
    [ -f "$tf" ] || continue
    commits_verify "$tf" "$CANDIDATE_SHA" || continue
    tf_status=$(task_status "$tf")
    if [ "$tf_status" != "DONE" ]; then
      UNIT_ID=$(basename "$tf" .md)
      STATUS="$tf_status"
      KIND="notdone"
      break 2
    fi
  done

  # Signal 2 (Fix 1b/1c): ref-derived, bound to this SAME key. Only the
  # canonical task-branch shape gates (nazgul/plan.md -> C1); an
  # off-convention ref (e.g. docs/TASK-001) evades this signal and falls
  # back to content-matching only. A ref naming a task with no manifest file
  # is untracked and ignored.
  if [[ "$CANDIDATE_REF" =~ $REF_TASK_RE ]]; then
    tf="$REPO_ROOT/nazgul/tasks/${BASH_REMATCH[1]}.md"
    if [ -f "$tf" ]; then
      tf_status=$(task_status "$tf")
      if [ "$tf_status" != "DONE" ]; then
        UNIT_ID="${BASH_REMATCH[1]}"
        STATUS="$tf_status"
        KIND="notdone"
        break
      fi
      if ! commits_verify "$tf" "$CANDIDATE_SHA"; then
        UNIT_ID="${BASH_REMATCH[1]}"
        STATUS="$tf_status"
        KIND="unverifiable"
        break
      fi
    fi
  fi
done < <(printf '%s' "$CANDIDATE_PAIRS_JSON" | jq -r '.[] | "\(.sha)\t\(.ref)"' 2>/dev/null)

# Both identity signals missed. This merge is ALLOWED, and that is deliberate
# — see the "compound-miss" note in the header block. It is also the one path
# where this guard admits a merge it cannot reason about, so it must not be
# silent: a gate that declines to act should say so (FEAT-023's thesis). The
# advisory is stderr-only and does NOT change the exit code.
if [ -z "$UNIT_ID" ]; then
  echo "NAZGUL GUARD: advisory — merge allowed with no task identity resolved (no candidate ref matched ${REF_TASK_RE}, and no manifest's ## Commits section records a merged SHA). Not blocked: with neither signal, the guard has no evidence this is a tracked task merge at all." >&2
fi

[ -n "$UNIT_ID" ] || _dispatch_and_exit

if [ "$KIND" = "unverifiable" ]; then
  echo "NAZGUL GUARD: Blocked — merge includes $UNIT_ID (status='${STATUS:-none}'), identified by its branch name, but its manifest's ## Commits section records no commit matching the merged content; unverifiable, not admitted." >&2
else
  echo "NAZGUL GUARD: Blocked — merge includes $UNIT_ID (status='${STATUS:-none}'); merge requires status DONE." >&2
fi
exit 1
